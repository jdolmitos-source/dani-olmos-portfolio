rules_version = '2';

// -----------------------------------------------------------------------
// Firestore Security Rules — Shoe Last Digitization Platform
//
// Role model:
//   - "client"   -> can only read/write projects where projects.clientId == uid
//   - "designer" -> full read/write access across all projects
//
// Roles are assigned via Firebase Auth custom claims (request.auth.token.role)
// Custom claims must be set server-side (Cloud Function / admin script),
// never trust a role field stored in a client-writable document.
// -----------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function isDesigner() {
      return isSignedIn() && role() == 'designer';
    }

    function isOwner(clientId) {
      return isSignedIn() && request.auth.uid == clientId;
    }

    // Whitelists the only status transitions the app's own logic ever
    // performs (see modules/upload/upload.service.js). Anything else —
    // e.g. a tampered client jumping straight from "draft" to
    // "ready_for_workspace" without real processing — is rejected here,
    // not just prevented by "well-behaved" client code.
    function isValidStatusTransition(before, after) {
      return before == after
        || (before == 'draft' && after == 'processing')
        || (before == 'processing' && after == 'ready_for_workspace')
        || (before == 'processing' && after == 'error')
        || (before == 'error' && after == 'processing');
    }

    // ---------------------------------------------------------------
    // users/{uid}
    // Each user can read/update their own profile document.
    // Role changes must NOT be allowed from the client.
    // ---------------------------------------------------------------
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isDesigner());
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role; // role is immutable from client
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // projects/{projectId}
    // ---------------------------------------------------------------
    match /projects/{projectId} {
      allow read: if isDesigner() || isOwner(resource.data.clientId);

      allow create: if isSignedIn()
                    && request.resource.data.clientId == request.auth.uid
                    && request.resource.data.status == 'draft'
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100;

      allow update: if (isDesigner() || isOwner(resource.data.clientId))
                    && request.resource.data.clientId == resource.data.clientId // clientId immutable
                    && isValidStatusTransition(resource.data.status, request.resource.data.status);

      allow delete: if isDesigner();

      // -------------------------------------------------------------
      // projects/{projectId}/views/{viewType}
      // -------------------------------------------------------------
      match /views/{viewType} {
        allow read: if isDesigner() || isOwner(get(/databases/$(database)/documents/projects/$(projectId)).data.clientId);
        allow write: if isDesigner() || isOwner(get(/databases/$(database)/documents/projects/$(projectId)).data.clientId);
      }

      // -------------------------------------------------------------
      // projects/{projectId}/statusHistory/{entryId}
      // Append-only audit trail. Clients can read but never write directly;
      // entries are written by the app logic (client-side pipeline) or
      // trusted Cloud Functions.
      // -------------------------------------------------------------
      match /statusHistory/{entryId} {
        allow read: if isDesigner() || isOwner(get(/databases/$(database)/documents/projects/$(projectId)).data.clientId);
        allow create: if isDesigner() || isOwner(get(/databases/$(database)/documents/projects/$(projectId)).data.clientId);
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
